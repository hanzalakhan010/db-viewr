# Version control
.git
.gitignore
.gitattributes

# Python caches
__pycache__
*.pyc
*.pyo
*.pyd
*.pdb
*.egg-info
dist/
build/
.eggs/

# Virtual environments
venv/
.venv/
env/
.env/

# Sensitive / local state — never bake into the image
connections.json
.env
.env.*
*.env

# SQLite files — mount at runtime via docker-compose volumes instead
*.db
*.sqlite
*.sqlite3

# Editor / OS noise
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Test / CI artefacts
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# Docker files themselves (not needed inside the image)
Dockerfile
docker-compose.yml
.dockerignore
